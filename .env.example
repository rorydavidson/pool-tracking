# ---------------------------------------------------------------------------
# Pool Tracking — environment configuration
# Copy to `.env` and adjust. docker-compose reads this file automatically.
# ---------------------------------------------------------------------------

# Secret used to sign session cookies, magic-link tokens, and to derive the
# encryption key for stored device credentials. MUST be long and random.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=change-me-to-a-long-random-string

# Public base URL the app is reached on. Used to build magic-link URLs.
BASE_URL=http://localhost:8000

# Where the SQLite database and dev email outbox live (inside the container).
DATA_DIR=/data

# --- Magic-link email delivery -------------------------------------------
# Provider is chosen automatically: Resend if RESEND_API_KEY is set, else
# SMTP if SMTP_HOST is set, else "console" mode (login links printed to the
# logs and written to $DATA_DIR/outbox/). Console mode lets you try the app
# immediately with no mail provider.
#
# Resend (https://resend.com): create an API key and verify the sending
# domain used in EMAIL_FROM, then set:
RESEND_API_KEY=
#
# SMTP (used only when RESEND_API_KEY is empty):
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# Must be an address on a domain you've verified with your provider.
EMAIL_FROM=Pool Tracking <no-reply@pooltracking.local>

# Magic links expire after this many minutes.
MAGIC_LINK_TTL_MINUTES=15

# Comma-separated list of email addresses allowed to sign in. Strongly
# recommended on a public deployment: with this empty, anyone who reaches the
# login page can create an account. Addresses not listed get no email and no
# account (the page shown is the same either way, so the list can't be probed).
ALLOWED_EMAILS=

# --- Claude (Anthropic) advice engine ------------------------------------
# The app asks Claude to analyse readings and produce dosing advice on the fly.
# Without a key it falls back to a basic in/out-of-range check.
ANTHROPIC_API_KEY=
ADVICE_MODEL=claude-sonnet-5
ADVICE_EFFORT=medium

# --- Automatic device syncing --------------------------------------------
# Background scheduler pulls readings from devices you've enabled auto-sync
# for (on the Devices page), no more often than this many hours. Manual sync
# always works regardless. Set to 0 to disable the scheduler entirely.
AUTO_SYNC_INTERVAL_HOURS=1

# Login session lifetime in days.
SESSION_TTL_DAYS=30

# --- MQTT publishing ------------------------------------------------------
# When MQTT_HOST is set, the scheduler publishes readings to your broker
# every MQTT_PUBLISH_INTERVAL_MINUTES:
#   <prefix>/<pool_id>/readings  - each new reading as it's stored (QoS 1)
#   <prefix>/<pool_id>/latest    - the pool's most recent reading (retained)
# Payloads are JSON in the app's canonical units (ppm, mV, uS/cm, Celsius).
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false
MQTT_TOPIC_PREFIX=pool_tracking
MQTT_PUBLISH_INTERVAL_MINUTES=15
